// Cloudflare Workers config: serves the built PWA from ./dist as static assets.
// Static requests run no Worker code, so they stay free and unmetered on the free plan.
// Only /api/* reaches worker/index.js (the food search; free plan: 100,000 requests a day).
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "name": "solo-leveling",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths (e.g. /workouts/active) get index.html so the React router can handle them.
    // This replaces the old `/* /index.html 200` _redirects rule, which Cloudflare rejects as a loop.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
