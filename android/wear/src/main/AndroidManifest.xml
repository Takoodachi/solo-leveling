<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- The workout's card and the "Rest over" card -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The buzz at the end of a rest, on time with the screen off -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- The heart rate on the screen, from the watch's own sensor while the app is up (Android 16 gave it a permission of its own) -->
    <uses-permission android:name="android.permission.BODY_SENSORS" android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library android:name="com.google.android.wearable" android:required="false" />
        <!-- It shows what the phone app is doing, so it needs the phone -->
        <meta-data android:name="com.google.android.wearable.standalone" android:value="false" />

        <activity
            android:name=".WatchActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Woken by Play services when the phone changes the workout, even with the app closed -->
        <service
            android:name=".WorkoutListener"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:path="/workout" />
            </intent-filter>
        </service>

        <receiver android:name=".RestOverReceiver" android:exported="false" />

        <!-- The tile: the workout a swipe away from the watch face -->
        <service
            android:name=".WorkoutTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_ascent"
            android:label="@string/tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data android:name="androidx.wear.tiles.PREVIEW" android:resource="@drawable/ic_launcher_foreground" />
        </service>
    </application>
</manifest>
