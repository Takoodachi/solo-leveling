<?xml version="1.0" encoding="utf-8"?>
<!-- Quick log (Widgets.kt). Redrawn every 30 minutes so a new day's creatine starts unticked. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_quick_description"
    android:initialLayout="@layout/widget_quick"
    android:minWidth="250dp"
    android:minHeight="50dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="50dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_quick"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
