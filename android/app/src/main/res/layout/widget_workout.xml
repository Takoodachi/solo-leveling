<?xml version="1.0" encoding="utf-8"?>
<!-- Today's workout: the routine planned for today and a button to start it (Widgets.kt) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:tint="#FF1C1C1F" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">

            <ImageView
                android:id="@+id/workout_icon_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_circle"
                android:tint="#FFFF5F1A" />

            <ImageView
                android:id="@+id/workout_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_workout" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/workout_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Push Day"
                android:textColor="#FFF4F1EC"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/workout_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="6 exercises · about 55 min"
                android:textColor="#FF8E8E95"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- A fixed size: a FrameLayout sized by its content leaves a lone match_parent child (the pill) unmeasured -->
        <FrameLayout
            android:id="@+id/workout_button"
            android:layout_width="88dp"
            android:layout_height="40dp">

            <ImageView
                android:id="@+id/workout_button_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_pill"
                android:tint="#FFF4F1EC" />

            <TextView
                android:id="@+id/workout_button_label"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:maxLines="1"
                android:text="Start"
                android:textColor="#FF0E0E10"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
