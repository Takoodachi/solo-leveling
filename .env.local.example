# Copy this file to .env.local and fill in your Supabase credentials.
# Supabase dashboard → your project → Project Settings → API Keys.
# Use the *publishable* (anon) key — never the service_role / secret key.
# Leave both empty to run the app fully local (no sign-in, no sync).

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Optional: "describe a meal" AI estimates. Needs the parse-food Edge Function
# deployed with a paid ANTHROPIC_API_KEY secret, so it's off by default.
VITE_ENABLE_AI_FOOD=false
